# Config template for the compose DHCPv4 test; scripts/render-config.sh fills
# in the markers. The checker parses the rendered file for its expectations.

server4:
    # Bound to eth0, so replies leave through the interface the request arrived
    # on, which is what makes the layer-2 unicast path work.
    listen:
        - "%eth0"

    plugins:
        # Order matters: everything that decorates the reply comes before
        # `file`, which stops the chain as soon as it matches a MAC.
        - lease_time: @LEASE_TIME@
        - server_id: @NET@.2
        - dns: @NET@.1 9.9.9.9
        - router: @NET@.1
        - netmask: 255.255.255.0

        # Static leases keyed on MAC, so the assertions are deterministic.
        - file: "/etc/coredhcp/leases-v4.txt"

        # The lease database goes on a writable volume; /etc/coredhcp is
        # read-only.
        - range: /var/lib/coredhcp/leases.sqlite3 @NET@.100 @NET@.110 @LEASE_TIME@
