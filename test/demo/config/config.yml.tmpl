# Config template for the demo; scripts/render-config.sh fills in the markers.
# The chain is longer than needed on purpose, so the UI's plugin pane shows it.

server4:
    # Bound to eth0, so replies leave through the interface the request arrived
    # on, which is what makes the layer-2 unicast path work.
    listen:
        - "%eth0"

    plugins:
        # First in the chain, so it also counts what macfilter drops. Nothing
        # scrapes it here; it is in the config to be seen in the UI.
        - metrics: 127.0.0.1:9754

        # client-denied's MAC. The UI names macfilter as the plugin that ended
        # the chain.
        - macfilter: deny @MAC_DENIED@

        # Short on purpose, so renewals and expiries happen while watching.
        - lease_time: @LEASE_TIME@
        - server_id: @NET@.2
        - dns: @NET@.1 9.9.9.9
        - router: @NET@.1
        - netmask: 255.255.255.0
        # Option 15, the domain name.
        - options: 15:string:demo.lan
        - ntp: @NET@.1

        # Everything that decorates the reply comes before this, because the
        # file plugin stops the chain as soon as it matches a MAC.
        - file: "/etc/coredhcp/leases-v4.txt"

        # A small pool on purpose, so client-churn can empty it. The lease
        # database goes on a writable volume; /etc/coredhcp is read-only.
        - range: /var/lib/coredhcp/leases.sqlite3 @NET@.100 @NET@.109 @LEASE_TIME@
