# Static DHCPv4 leases for the demo, one "MAC IP" pair per line.
#
# Template: scripts/render-config.sh fills in the MAC addresses from the compose
# file, so a client and its lease cannot drift apart, and the network prefix
# from the compose network. The addresses sit below docker's own ip_range and
# below the range plugin's pool, so nothing else can already hold them.
@MAC_A@ @NET@.11
@MAC_B@ @NET@.12
@MAC_C@ @NET@.13
